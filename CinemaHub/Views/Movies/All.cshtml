@using CinemaHub.Data.Models.ViewModels
@model AllMoviesQueryModel

@{
    ViewData["Title"] = "All Movies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="movie-header mb-0 fw-bold">Movie Library</h2>
    @if (User.IsInRole("Administrator") || User.IsInRole("Moderator"))
    {
        <a asp-controller="Movies" asp-action="Add" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg"></i> Add New Movie
        </a>
    }
</div>

<div class="row mb-4">
    <div class="col-12">
        <form method="get" class="card card-body border-0 shadow-sm bg-light">
            <div class="row g-3 align-items-center">

                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input asp-for="SearchTerm" onchange="this.form.submit()"
                               class="form-control border-start-0 ps-0"
                               placeholder="Search movies by title..."
                               aria-label="Search" />
                    </div>
                </div>

                <div class="col-md-4">
                    <select asp-for="GenreId"
                            class="form-select cursor-pointer"
                            onchange="this.form.submit()">
                        <option value="">All Genres</option>
                        @if (Model.Genres != null)
                        {
                            @foreach (var genre in Model.Genres)
                            {
                                <option value="@genre.Id">@genre.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2 text-end">
                    <div class="d-grid gap-2 d-md-block">
                        <button type="submit" class="btn btn-primary w-100 d-md-none">Search</button>

                        <a asp-controller="Movies" asp-action="All"
                           class="btn btn-outline-secondary w-100 @(string.IsNullOrEmpty(Model.SearchTerm) && !Model.GenreId.HasValue ? "disabled border-0" : "")">
                            Clear
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Movies.Any())
{
    <div class="text-center py-5">
        <h3 class="text-muted">No movies found.</h3>
        <p class="text-secondary">Try adjusting your search or filter to find what you're looking for.</p>
        @if (User.IsInRole("Administrator") || User.IsInRole("Moderator"))
        {
            <a asp-controller="Movies" asp-action="Add" class="btn btn-outline-primary mt-2">Add a new movie</a>
        }
        else
        {
            <a asp-controller="Movies" asp-action="All" class="btn btn-outline-secondary mt-2">Clear Filters</a>
        }
    </div>
}
else
{
    <div class="row">
        @foreach (var movie in Model.Movies)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0 transition-hover">
                    <div class="position-relative overflow-hidden" style="height: 400px;">
                        <img src="@movie.ImageUrl"
                             class="card-img-top w-100 h-100"
                             style="object-fit: cover;"
                             alt="@movie.Title"
                             onerror="this.onerror=null; this.src='/images/Image-not-found.png';">

                        <span class="position-absolute top-0 end-0 bg-primary text-white px-3 py-1 m-2 rounded-pill small shadow">
                            @movie.Genre
                        </span>
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold text-truncate" title="@movie.Title">@movie.Title</h5>
                            <span class="badge bg-light text-dark border">@movie.Year</span>
                        </div>
                        <p class="card-text text-muted small text-truncate-2">@movie.Description</p>
                    </div>

                    <div class="card-footer bg-white border-top-0 pt-0">
                        <small class="text-muted d-block mb-3">
                            <i class="bi bi-people-fill me-1"></i>
                            @if (movie.Actors != null && movie.Actors.Any())
                            {
                                @string.Join(", ", movie.Actors.Take(3)) @(movie.Actors.Count > 3 ? "..." : "")
                            }
                            else
                            {
                                <span class="fst-italic">No cast info</span>
                            }
                        </small>

                        <div class="d-flex justify-content-between">
                            @if (User.IsInRole("Administrator") || User.IsInRole("Moderator"))
                            {
                                <div>
                                    <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-warning me-1">
                                        <i class="bi bi-pencil">Edit</i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@movie.Id" method="post" class="d-inline" onsubmit="return confirm('Delete movie?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash">Delete</i>
                                        </button>
                                    </form>
                                </div>
                            }
                            <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-primary ms-auto">
                                Details <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@{
    var maxPage = (int)Math.Ceiling((double)Model.TotalMoviesCount / Model.MoviesPerPage);

    // Колко страници да показваме около текущата (напр. Current=5 -> 3,4,[5],6,7)
    int neighborhood = 2;
}

@if (maxPage > 1)
{
    <nav aria-label="Page navigation" class="mt-5 pb-5">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link border-0 rounded-circle mx-1"
                    asp-controller="Movies"
                    asp-action="All"
                    asp-route-currentPage="@(Model.CurrentPage - 1)"
                    asp-route-searchTerm="@Model.SearchTerm"
                    asp-route-genreId="@Model.GenreId">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @{
                // АКО СТРАНИЦИТЕ СА МАЛКО (ПОД 7), ПОКАЗВАМЕ ВСИЧКИ
                if (maxPage <= 7)
                {
                    for (int i = 1; i <= maxPage; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link border-0 rounded-circle mx-1 shadow-sm"
                                asp-action="All"
                                asp-route-currentPage="@i"
                                asp-route-searchTerm="@Model.SearchTerm"
                                asp-route-genreId="@Model.GenreId">@i</a>
                        </li>
                    }
                }
                // АКО СА МНОГО, ПОЛЗВАМЕ ЛОГИКАТА С ТОЧКИТЕ
                else
                {
                    // 1. Винаги показваме Първа страница
                    <li class="page-item @(Model.CurrentPage == 1 ? "active" : "")">
                        <a class="page-link border-0 rounded-circle mx-1 shadow-sm"
                            asp-action="All"
                            asp-route-currentPage="1"
                            asp-route-searchTerm="@Model.SearchTerm"
                            asp-route-genreId="@Model.GenreId">1</a>
                    </li>

                    // 2. Слагаме многоточие, ако сме далеч от началото (напр. сме на стр. 10)
                    if (Model.CurrentPage > neighborhood + 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link border-0 bg-transparent text-muted">...</span>
                        </li>
                    }

                    // 3. Средната част (Window)
                    // Изчисляваме откъде да почнем и къде да свършим, за да не дублираме 1 и maxPage
                    var startPage = Math.Max(2, Model.CurrentPage - neighborhood);
                    var endPage = Math.Min(maxPage - 1, Model.CurrentPage + neighborhood);

                    for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link border-0 rounded-circle mx-1 shadow-sm"
                                asp-action="All"
                                asp-route-currentPage="@i"
                                asp-route-searchTerm="@Model.SearchTerm"
                                asp-route-genreId="@Model.GenreId">@i</a>
                        </li>
                    }

                    // 4. Слагаме многоточие преди края, ако сме далеч от последната страница
                    if (Model.CurrentPage < maxPage - (neighborhood + 1))
                    {
                        <li class="page-item disabled">
                            <span class="page-link border-0 bg-transparent text-muted">...</span>
                        </li>
                    }

                    // 5. Винаги показваме Последна страница
                    <li class="page-item @(Model.CurrentPage == maxPage ? "active" : "")">
                        <a class="page-link border-0 rounded-circle mx-1 shadow-sm"
                            asp-action="All"
                            asp-route-currentPage="@maxPage"
                            asp-route-searchTerm="@Model.SearchTerm"
                            asp-route-genreId="@Model.GenreId">@maxPage</a>
                    </li>
                }
            }

            <li class="page-item @(Model.CurrentPage == maxPage ? "disabled" : "")">
                <a class="page-link border-0 rounded-circle mx-1"
                    asp-controller="Movies"
                    asp-action="All"
                    asp-route-currentPage="@(Model.CurrentPage + 1)"
                    asp-route-searchTerm="@Model.SearchTerm"
                    asp-route-genreId="@Model.GenreId">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
