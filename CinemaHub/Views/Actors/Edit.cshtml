@model CinemaHub.Data.Models.Actor

@{
    ViewData["Title"] = "Edit Actor";
}

<h2 class="text-center">Edit Actor</h2>
<hr />

<div class="row">
    <div class="col-md-6 offset-md-3">
        <form method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            @if (User.IsInRole("Administrator") || User.IsInRole("Moderator"))
            {
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-warning">Save Changes</button>
                    <a asp-action="All" class="btn btn-outline-secondary">Cancel</a>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
 }