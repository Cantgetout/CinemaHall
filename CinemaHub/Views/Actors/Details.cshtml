@using CinemaHub.Data.Models.ViewModels
@model ActorDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h2>@Model.Name</h2>
        </div>
        <div class="card-body">
            <h4 class="card-title">Biography</h4>
            <p class="card-text">@Model.Bio</p>

            <hr />

            <h4 class="mt-4">Filmography (Movies)</h4>
            @if (Model.Movies.Any())
            {
                <div class="row">
                    @foreach (var movie in Model.Movies)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <h5 class="card-title mb-0">@movie.Title</h5>
                                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-primary">View</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">This actor has not been added to any movies yet.</p>
            }

            <div class="mt-4">
                @if (User.IsInRole("Administrator") || User.IsInRole("Moderator"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit Actor</a>
                }
                <a asp-action="All" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>