@model IEnumerable<CinemaHub.Data.Models.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Admin Panel";
    var currentSort = ViewBag.CurrentSort as string ?? "";
}

<div class="container mt-4">
    <h1 class="text-danger mb-4" style="font-weight: bold; text-transform: uppercase;">Admin Panel</h1>

    <div class="mb-4">
        <span class="text-light me-2">Sort By:</span>

        <a asp-action="Index" asp-route-sortOrder=""
           class="btn btn-sm @(string.IsNullOrEmpty(currentSort) ? "btn-outline-danger" : "btn-outline-light")">
            Default (Mods First)
        </a>

        <a asp-action="Index" asp-route-sortOrder="@ViewBag.RoleSortParm"
           class="btn btn-sm @(currentSort == "Role" || currentSort == "role_desc" ? "btn-outline-danger" : "btn-outline-light")">
            Role
        </a>

        <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSortParm"
           class="btn btn-sm @(currentSort == "Name" || currentSort == "name_desc" ? "btn-outline-danger" : "btn-outline-light")">
            Name
        </a>

        <a asp-action="Index" asp-route-sortOrder="@ViewBag.EmailSortParm"
           class="btn btn-sm @(currentSort == "Email" || currentSort == "email_desc" ? "btn-outline-danger" : "btn-outline-light")">
            Email
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover border-dark align-middle">
            <thead class="text-danger">
                <tr>
                    <th>Full Name</th>
                    <th>Email Account</th>
                    <th>Current Access Level</th>
                    <th>Manage Account</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            <span class="badge @(user.Role == "Administrator" ? "bg-danger" : user.Role == "Moderator" ? "bg-warning text-dark" : "bg-secondary")">
                                @user.Role
                            </span>
                        </td>
                        <td>
                            @if (user.Role != "Administrator")
                            {
                                <div class="d-flex gap-2">
                                    @if (user.Role != "User")
                                    {
                                        <form asp-action="Demote" method="post">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class=" align-content-center btn btn-sm btn-outline-secondary">Make User</button>
                                        </form>
                                    }
                                    @if (user.Role != "Moderator")
                                    {
                                        <form asp-action="Promote" method="post">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning">Make Mod</button>
                                        </form>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('WARNING: Are you sure you want to permanently BAN and delete this user?');">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger">Ban User</button>
                                        </form>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted"><i>System Locked</i></span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>