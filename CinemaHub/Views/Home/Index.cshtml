@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 rounded-3 text-center position-relative overflow-hidden"
     style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.8)), url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=2070&auto=format&fit=crop'); background-size: cover; background-position: center; height: 500px; display: flex; align-items: center; justify-content: center;">

    <div class="position-relative z-index-1">
        <h1 class="display-3 fw-bold text-white mb-3">Welcome to <span style="color: #e50914;">CinemaHub</span></h1>
        <p class="lead text-light mb-4 fs-4">Experience the magic of movies. <br /> Book your tickets for the latest blockbusters today.</p>

        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Movies" asp-action="All" class="btn btn-primary btn-lg px-5 py-3 fw-bold shadow">
                <i class="bi bi-ticket-perforated"></i> Browse Movies
            </a>
            <a asp-controller="Screenings" asp-action="All" class="btn btn-outline-light btn-lg px-5 py-3 fw-bold">
                View Schedule
            </a>
        </div>
    </div>
</div>

<div class="row text-center mt-5">
    <div class="col-md-4 mb-4">
        <div class="p-4 h-100 bg-dark rounded shadow-sm border border-secondary border-opacity-25">
            <div class="mb-3 text-primary">
                <i class="bi bi-film" style="font-size: 3rem; color: #e50914;"></i>
            </div>
            <h3 class="text-white">Latest Movies</h3>
            <p>Discover the newest releases across all genres. From Action to Sci-Fi.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="p-4 h-100 bg-dark rounded shadow-sm border border-secondary border-opacity-25">
            <div class="mb-3 text-primary">
                <i class="bi bi-star-fill" style="font-size: 3rem; color: #e50914;"></i>
            </div>
            <h3 class="text-white">Top Actors</h3>
            <p>Learn more about your favorite stars and their filmography.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="p-4 h-100 bg-dark rounded shadow-sm border border-secondary border-opacity-25">
            <div class="mb-3 text-primary">
                <i class="bi bi-geo-alt-fill" style="font-size: 3rem; color: #e50914;"></i>
            </div>
            <h3 class="text-white">Premium Halls</h3>
            <p>Enjoy the movies in our VIP, IMAX, and Grand Halls with ultimate comfort.</p>
        </div>
    </div>
</div>

<div class="row align-items-center mt-5 mb-5 p-5 bg-dark rounded border border-secondary border-opacity-10">
    <div class="col-md-8">
        <h2 class="fw-bold">Ready to watch?</h2>
        <p class="mb-0">Join us now and never miss a premiere.</p>
    </div>
    <div class="col-md-4 text-end">
        @if (!User.Identity.IsAuthenticated)
        {
            <a class="btn btn-outline-light btn-lg" asp-area="Identity" asp-page="/Account/Register">Sign Up Now</a>
        }
        else
        {
            <a class="btn btn-primary btn-lg" asp-controller="Screenings" asp-action="All">Buy Tickets</a>
        }
    </div>
</div>